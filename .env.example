# Copy to .env and replace every CHANGE_ME value before first start.
WORKLEDGER_SECRET_KEY=CHANGE_ME_generate_a_long_random_value
POSTGRES_DB=workledger
POSTGRES_USER=workledger_owner
POSTGRES_PASSWORD=CHANGE_ME_database_password
APP_DATABASE_PASSWORD=CHANGE_ME_application_database_password
DATABASE_URL=postgresql://workledger_app:CHANGE_ME_application_database_password@postgres:5432/workledger
MIGRATION_DATABASE_URL=postgresql://workledger_owner:CHANGE_ME_database_password@postgres:5432/workledger
WORKLEDGER_RUNTIME_DB_USER=workledger_app
REDIS_URL=redis://redis:6379/0
WORKLEDGER_DATA_DIR=./workledger-data
WORKLEDGER_BACKUP_DIR=./workledger-backups
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=compose.yaml
WORKLEDGER_REVIEW_HOST=
WORKLEDGER_REVIEW_PORT=8788
WORKLEDGER_ALLOWED_HOSTS=localhost,127.0.0.1
WORKLEDGER_CSRF_TRUSTED_ORIGINS=http://localhost:8787,http://127.0.0.1:8787
WORKLEDGER_SECURE_COOKIES=false
WORKLEDGER_SSL_REDIRECT=false
WORKLEDGER_HSTS_SECONDS=31536000
WORKLEDGER_HSTS_INCLUDE_SUBDOMAINS=false
WORKLEDGER_HSTS_PRELOAD=false
WORKLEDGER_MAX_UPLOAD_BYTES=1073741824
WORKLEDGER_MIN_FREE_DISK_BYTES=2147483648
CELERY_WORKER_CONCURRENCY=2
DB_TIMETABLES_CLIENT_ID=
DB_TIMETABLES_API_KEY=
OPENROUTESERVICE_API_KEY=
TZ=Europe/Berlin
